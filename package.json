{
  "name": "forms-queue",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "worker"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "worker": "yarn workspace @forms-queue/worker",
    "lint": "yarn workspaces foreach -A run lint",
    "test": "yarn workspaces foreach -A run test",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "semantic-release": "^24.2.9"
  },
  "packageManager": "yarn@4.0.2",
  "dependencies": {
    "dotenv": "^16.6.1",
    "handlebars": "^4.7.9"
  },
  "resolutions": {
    "axios": "1.18.0",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "form-data": "4.0.6",
    "micromatch": "^4.0.8"
  },
  "release": {
    "branches": [
